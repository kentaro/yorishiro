#!/bin/sh
# yorishiro-init: stage zero of PID 1.
#
# Mount the pseudo filesystems BEFORE Gauche starts, so its GC can read
# /proc/self/maps for stack bounds (otherwise it probes memory and the
# kernel logs a scary-but-harmless segfault). Then exec gosh: exec
# replaces this shell, so PID 1 IS the Scheme interpreter from here on.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp
# Gauche's GC probes for stack bounds with a deliberate, caught SIGSEGV;
# keep the kernel from narrating it into the boot log.
[ -w /proc/sys/debug/exception-trace ] && echo 0 > /proc/sys/debug/exception-trace
exec /usr/bin/gosh /sbin/yorishiro-init.scm
